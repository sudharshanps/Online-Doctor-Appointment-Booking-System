# ==============================================================================
# MediLink Innovations - Online Doctor Appointment Booking System
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/medilink_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/medilink_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/medilink_db

# JWT Secret & Expiration
JWT_SECRET=medilink_super_secret_jwt_key_intermediate_project_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env) - Optional, defaults to proxy/localhost:5000
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
